{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "index.html",
    "distDir": "."
  },
  "package": {
    "productName": "KODI",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "gg.anticloud.kodi",
      "category": "DeveloperTool",
      "shortDescription": "KODI \u2014 Anticloud Sovereign AI Infrastructure",
      "longDescription": "Installer for KODI, part of the Anticloud sovereign AI infrastructure stack"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "KODI Installer",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}